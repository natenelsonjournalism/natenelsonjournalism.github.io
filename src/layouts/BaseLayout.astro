---
import '../styles/global.css';
import { CSP } from '../config/csp.mjs';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search engines (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.role}`;

const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/investigations/', label: 'Investigations' },
  { href: '/speaking/', label: 'Speaking' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
// "page" on the section's own page; "true" on pages inside it (e.g. a filter page).
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}>{SITE.name}</a>
      <nav class="site-nav" aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {SITE.name} · <a href="/contact/">Contact</a></p>
      <p>This site uses no cookies, trackers or scripts.</p>
    </footer>
  </body>
</html>
