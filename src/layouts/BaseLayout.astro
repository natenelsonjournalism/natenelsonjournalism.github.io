---
import '../styles/global.css';
import { CLI_SCRIPT, CSP, CSP_CLI } from '../config/csp.mjs';
import PersonJsonLd from '../components/PersonJsonLd.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search engines (e.g. the 404 page). */
  noindex?: boolean;
  /** Open Graph type: "article" for case studies, "profile" for About. */
  ogType?: 'website' | 'article' | 'profile';
  /** Add schema.org Person structured data (the homepage). */
  person?: boolean;
  /** The homepage terminal: loads public/cli.js under the CSP that allows it. */
  cli?: boolean;
  /** Where the visitor is, shown in the header prompt, e.g. "~/stories". */
  cwd?: string;
}

const { title, description = SITE.description, noindex = false, ogType = 'website', person = false, cli = false, cwd = '~' } =
  Astro.props;

// Canonical URLs always point at the real site, so Cloudflare preview copies
// never compete with it in search results.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL('/og-default.png', Astro.site).href;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.role}`;

// Shown to anyone who opens "View source". Not a script: browsers ignore HTML comments.
const sourceNote = `<!--
  _  _      _         _  _     _
 | \\| |__ _| |_ ___  | \\| |___| |___ ___ _ _
 | .\` / _\` |  _/ -_) | .\` / -_) (_-</ _ \\ ' \\
 |_|\\_\\__,_|\\__\\___| |_|\\_\\___|_/__/\\___/_||_|

  Hello, fellow source reader.
  One small script (/cli.js, the command box; read it, it's short).
  No cookies, no trackers, no third-party requests.
  Found a security problem? /.well-known/security.txt
  Have a tip? Type "ping" on the homepage.
-->`;
---

<!doctype html>
<Fragment set:html={sourceNote} />
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={cli ? CSP_CLI : CSP} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}, ${SITE.role.toLowerCase()}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: new work`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {person && <PersonJsonLd />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      !cli && (
        <header class="site-header">
          <p class="site-prompt">
            <a class="site-name" href="/"><span aria-hidden="true">nate@nelson</span><span class="visually-hidden">{SITE.name}, home</span></a><span class="site-cwd" aria-hidden="true">:{cwd}$</span>
          </p>
        </header>
      )
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {SITE.name} · This site uses no cookies or trackers.</p>
    </footer>
    {cli && <script is:inline src={CLI_SCRIPT} defer></script>}
  </body>
</html>
