---
import '../styles/global.css';
import { CSP } from '../config/csp.mjs';
import PersonJsonLd from '../components/PersonJsonLd.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search engines (e.g. the 404 page). */
  noindex?: boolean;
  /** Open Graph type: "article" for case studies, "profile" for About. */
  ogType?: 'website' | 'article' | 'profile';
  /** Add schema.org Person structured data (Home and About). */
  person?: boolean;
}

const { title, description = SITE.description, noindex = false, ogType = 'website', person = false } = Astro.props;

// Canonical URLs always point at the real site, so Cloudflare preview copies
// never compete with it in search results.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL('/og-default.png', Astro.site).href;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.role}`;

const nav = [
  { href: '/journalism/', label: 'Journalism' },
  { href: '/podcasts/', label: 'Podcasts' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
// "page" on the section's own page; "true" on pages inside it (e.g. an investigation).
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}, ${SITE.role.toLowerCase()}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: new work`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {person && <PersonJsonLd />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}>{SITE.name}</a>
      <nav class="site-nav" aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        &copy; {new Date().getFullYear()} {SITE.name} · <a href="/contact/">Contact</a> · <a href="/rss.xml"
          >RSS feed</a
        >
      </p>
      <p>This site uses no cookies, trackers or scripts.</p>
    </footer>
  </body>
</html>
