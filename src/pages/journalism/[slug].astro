---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getInvestigations, isoDate, storyLink } from '../../lib/content';

export const getStaticPaths = (async () => {
  const investigations = await getInvestigations();
  return investigations.map((inv) => ({ params: { slug: inv.id }, props: { inv } }));
}) satisfies GetStaticPaths;

const { inv } = Astro.props;
const { Content } = await render(inv);
const original = storyLink(inv);
---

<BaseLayout title={inv.data.title} description={inv.data.summary} ogType="article">
  <article>
    <div class="page-intro">
      <p class="eyebrow"><a href="/journalism/">Journalism</a> · Investigation</p>
      <h1>{inv.data.title}</h1>
      <p class="meta">
        {inv.data.outlet} · <time datetime={isoDate(inv.data.date)}>{formatDate(inv.data.date)}</time>
      </p>
      <p class="lede">{inv.data.summary}</p>
      <p class="more-link">
        {
          original.href ? (
            <a href={original.href} rel="noopener noreferrer">
              {original.archived ? `Read the story (archived copy) →` : `Read the story at ${inv.data.outlet} →`}
            </a>
          ) : (
            <span class="meta">The original story is no longer online.</span>
          )
        }
      </p>
    </div>

    <section class="impact" aria-labelledby="impact-heading">
      <h2 id="impact-heading">Impact</h2>
      <ul>
        {inv.data.impact.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
