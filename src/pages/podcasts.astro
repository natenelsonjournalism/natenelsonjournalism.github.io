---
import BaseLayout from '../layouts/BaseLayout.astro';
import Episode from '../components/Episode.astro';
import Placeholder from '../components/Placeholder.astro';
import { SITE } from '../config/site';
import { getPodcasts } from '../lib/content';

const shows = await getPodcasts();
const LISTEN = [
  { key: 'spotify', label: 'Spotify' },
  { key: 'apple', label: 'Apple Podcasts' },
  { key: 'website', label: 'Show website' },
] as const;
---

<BaseLayout title="Podcasts" description={`Podcasts written by ${SITE.name}.`}>
  <h1 class="page-lead">Recent shows I’ve written:</h1>

  {shows.length === 0 && <Placeholder>Your podcasts go here (src/data/podcasts.yaml).</Placeholder>}

  {
    shows.map((show) => {
      const links = LISTEN.filter((l) => show.data.links[l.key]);
      return (
        <section class="show" aria-labelledby={`show-${show.id}`}>
          <div class="show-header">
            {show.data.cover && <img class="show-cover" src={show.data.cover} alt="" width="128" height="128" loading="lazy" />}
            <div>
              <h2 id={`show-${show.id}`}>{show.data.name}</h2>
              <p class="meta">{[show.data.role, show.data.years].filter(Boolean).join(' · ')}</p>
              <p>{show.data.description}</p>
              {links.length > 0 && (
                <ul class="listen-links" aria-label={`Listen to ${show.data.name}`}>
                  {links.map((l) => (
                    <li>
                      <a href={show.data.links[l.key]} rel="noopener noreferrer">
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
          {show.data.episodes.map((episode) => (
            <Episode episode={episode} show={show.data.name} />
          ))}
        </section>
      );
    })
  }
</BaseLayout>
