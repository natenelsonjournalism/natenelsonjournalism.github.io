---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getInvestigations, isoDate } from '../../lib/content';

const investigations = await getInvestigations();
---

<BaseLayout title="Investigations" description="Case studies of Nate Nelson's investigative reporting and its impact.">
  <div class="page-intro">
    <h1>Investigations</h1>
    <p class="lede">Longer projects: how the reporting came together, and what changed because of it.</p>
  </div>
  {
    investigations.map((inv) => (
      <article class="investigation-card">
        <h2>
          <a href={`/investigations/${inv.id}/`}>{inv.data.title}</a>
        </h2>
        <p class="meta">
          {inv.data.outlets.join(', ')} · <time datetime={isoDate(inv.data.date)}>{formatDate(inv.data.date)}</time>
        </p>
        <p>{inv.data.summary}</p>
        <p class="label">Impact</p>
        <ul class="impact-inline">
          {inv.data.impact.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    ))
  }
</BaseLayout>
