---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClipsByYear from '../../components/ClipsByYear.astro';
import WorkFilters from '../../components/WorkFilters.astro';
import { getClips } from '../../lib/content';

const clips = await getClips();
---

<BaseLayout title="Work" description="Published reporting by Nate Nelson, newest first, by topic, outlet and year.">
  <div class="page-intro">
    <h1>Work</h1>
    <p class="lede">Published reporting, newest first.</p>
  </div>
  <WorkFilters clips={clips} current="/work/" />
  <ClipsByYear clips={clips} />
</BaseLayout>
