---
import type { GetStaticPaths } from 'astro';
import FilteredWork from '../../../components/FilteredWork.astro';
import { getClips, getYears } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const clips = await getClips();
  return getYears(clips).map((year) => ({
    params: { year: String(year) },
    props: { year, clips: clips.filter((c) => c.data.date.getUTCFullYear() === year), allClips: clips },
  }));
}) satisfies GetStaticPaths;

const { year, clips, allClips } = Astro.props;
---

<FilteredWork name={String(year)} kind="Year" clips={clips} allClips={allClips} />
