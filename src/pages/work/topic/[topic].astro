---
import type { GetStaticPaths } from 'astro';
import FilteredWork from '../../../components/FilteredWork.astro';
import { TOPICS, type Topic } from '../../../config/topics';
import { getClips } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const clips = await getClips();
  return (Object.keys(TOPICS) as Topic[])
    .map((topic) => ({ topic, matching: clips.filter((c) => c.data.topics.includes(topic)) }))
    .filter(({ matching }) => matching.length > 0)
    .map(({ topic, matching }) => ({ params: { topic }, props: { topic, clips: matching, allClips: clips } }));
}) satisfies GetStaticPaths;

const { topic, clips, allClips } = Astro.props;
---

<FilteredWork name={TOPICS[topic]} kind="Topic" clips={clips} allClips={allClips} />
