---
import type { GetStaticPaths } from 'astro';
import FilteredWork from '../../../components/FilteredWork.astro';
import { getClips, getOutlets } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const clips = await getClips();
  return getOutlets(clips).map((outlet) => ({
    params: { outlet: outlet.slug },
    props: { name: outlet.name, clips: clips.filter((c) => c.data.outlet === outlet.name), allClips: clips },
  }));
}) satisfies GetStaticPaths;

const { name, clips, allClips } = Astro.props;
---

<FilteredWork name={name} kind="Outlet" clips={clips} allClips={allClips} />
