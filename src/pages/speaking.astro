---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getAppearances, isoDate, type Appearance } from '../lib/content';

const appearances = await getAppearances();

const TYPES: { type: Appearance['data']['type']; label: string }[] = [
  { type: 'talk', label: 'Talks' },
  { type: 'panel', label: 'Panels' },
  { type: 'podcast', label: 'Podcasts' },
  { type: 'tv', label: 'Television' },
  { type: 'radio', label: 'Radio' },
];
const groups = TYPES.map((t) => ({ ...t, items: appearances.filter((a) => a.data.type === t.type) })).filter(
  (g) => g.items.length > 0,
);
---

<BaseLayout title="Speaking & media" description="Talks, panels, podcasts and broadcast appearances by Nate Nelson.">
  <div class="page-intro">
    <h1>Speaking &amp; media</h1>
    <p class="lede">
      Talks, panels and interviews. To invite me to speak, see <a href="/contact/">Contact</a>.
    </p>
  </div>
  {
    groups.map((group) => (
      <section class="stack" aria-labelledby={`type-${group.type}`}>
        <h2 class="section-heading" id={`type-${group.type}`}>
          {group.label}
        </h2>
        <ul class="plain-list">
          {group.items.map((a) => (
            <li class="clip clip-compact">
              <h3 class="clip-title">{a.data.url ? <a href={a.data.url}>{a.data.title}</a> : a.data.title}</h3>
              <p class="meta">
                {a.data.event_or_show} · <time datetime={isoDate(a.data.date)}>{formatDate(a.data.date)}</time>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
