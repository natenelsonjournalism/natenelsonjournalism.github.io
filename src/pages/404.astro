---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/Prompt.astro';

const places = [
  { href: '/', dir: '~', label: 'Home' },
  { href: '/journalism/', dir: '~/journalism', label: 'Journalism' },
  { href: '/podcasts/', dir: '~/podcasts', label: 'Podcasts' },
  { href: '/contact/', dir: '~/contact', label: 'Contact' },
];
---

<BaseLayout title="Page not found" noindex>
  <div class="page-intro">
    <p class="prompt" aria-hidden="true">bash: cd: no such file or directory</p>
    <h1 class="page-lead">Page not found. It may have moved, or the link may have a typo.</h1>
    <p class="prompt" aria-hidden="true">Try one of these:</p>
    <ul class="plain-list cmd-list">
      {
        places.map((p) => (
          <li>
            <a href={p.href}>
              <span aria-hidden="true">$ cd {p.dir}</span>
              <span class="cmd-comment">
                <span aria-hidden="true"># </span>
                {p.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <Prompt cursor />
  </div>
</BaseLayout>
