---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/Prompt.astro';
import StoryItem from '../components/StoryItem.astro';
import { ABOUT, SITE } from '../config/site';
import { getFeatures, getInvestigations, getPodcasts, getProjects, highlights, investigationPath } from '../lib/content';

// Investigations link to their write-up on this site; features to the original article.
const allStories = [
  ...(await getInvestigations()).map((story) => ({ story, href: investigationPath(story) as string | undefined })),
  ...(await getFeatures()).map((story) => ({ story, href: undefined })),
].sort((a, b) => b.story.data.date.getTime() - a.story.data.date.getTime());
const featured = allStories.filter((s) => s.story.data.featured);
const stories = (featured.length ? featured : allStories).slice(0, 2);
const shows = (await getPodcasts()).slice(0, 3);
const projects = highlights(await getProjects(), 3);
---

<BaseLayout person>
  <header class="home-intro">
    <div class="term">
      <div class="term-bar" aria-hidden="true">
        <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
        <span class="term-title">nate@nelson: ~</span>
      </div>
      <div class="term-body">
        <Prompt command="whoami" />
        <h1>{SITE.name}</h1>
        <p class="home-tagline">{SITE.tagline}</p>
        {
          ABOUT && (
            <details class="term-more">
              <summary>
                <span aria-hidden="true"><span class="ps1">$</span> cat about.txt</span><span class="visually-hidden">About me</span>
              </summary>
              <p>{ABOUT[0]}</p>
              <p>
                <a href="/about/">Read more about me</a>
              </p>
            </details>
          )
        }
        <Prompt cursor />
      </div>
    </div>
  </header>

  {
    stories.length > 0 && (
      <section aria-labelledby="journalism-heading">
        <h2 class="section-heading" id="journalism-heading">
          <span class="ps1" aria-hidden="true">$ ls ~/</span>journalism
        </h2>
        {stories.map(({ story, href }) => (
          <StoryItem story={story} href={href} />
        ))}
        <p class="more-link">
          <a href="/journalism/">
            <span aria-hidden="true">$ cd ~/</span><span class="visually-hidden">All </span>journalism
          </a>
        </p>
      </section>
    )
  }

  {
    shows.length > 0 && (
      <section aria-labelledby="podcasts-heading">
        <h2 class="section-heading" id="podcasts-heading">
          <span class="ps1" aria-hidden="true">$ ls ~/</span>podcasts
        </h2>
        {shows.map((show) => (
          <article class="clip clip-compact">
            <h3 class="clip-title">
              <a href={`/podcasts/#show-${show.id}`}>{show.data.name}</a>
            </h3>
            <p class="meta">{[show.data.role, show.data.years].filter(Boolean).join(' · ')}</p>
          </article>
        ))}
        <p class="more-link">
          <a href="/podcasts/">
            <span aria-hidden="true">$ cd ~/</span><span class="visually-hidden">All </span>podcasts
          </a>
        </p>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section aria-labelledby="projects-heading">
        <h2 class="section-heading" id="projects-heading">
          <span class="ps1" aria-hidden="true">$ ls ~/</span>projects
        </h2>
        {projects.map((p) => (
          <article class="clip clip-compact">
            <h3 class="clip-title">
              {p.data.url ? (
                <a href={p.data.url} rel="noopener noreferrer">
                  {p.data.name}
                </a>
              ) : (
                p.data.name
              )}
            </h3>
            <p class="meta">{p.data.summary}</p>
          </article>
        ))}
        <p class="more-link">
          <a href="/projects/">
            <span aria-hidden="true">$ cd ~/</span><span class="visually-hidden">All </span>projects
          </a>
        </p>
      </section>
    )
  }
</BaseLayout>
