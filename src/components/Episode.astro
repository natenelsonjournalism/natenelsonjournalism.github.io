---
// One podcast episode. With an `audio` address it gets the browser's own audio player;
// preload="none" means nothing is fetched from the show's host until the visitor presses
// play. Without one, the title links to the episode's page.
import { formatDate, isoDate, type Podcast } from '../lib/content';

interface Props {
  episode: Podcast['data']['episodes'][number];
  show: string;
  /** Heading level for the episode title, to keep the page outline correct. */
  headingLevel?: 3 | 4;
}

const { episode, show, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
const { title, date, summary, audio, url, transcript } = episode;
---

<article class="episode">
  <Heading class="clip-title">{url ? <a href={url} rel="noopener noreferrer">{title}</a> : title}</Heading>
  {date && <p class="meta"><time datetime={isoDate(date)}>{formatDate(date)}</time></p>}
  {summary && <p class="clip-summary">{summary}</p>}
  {
    audio && (
      <audio controls preload="none" src={audio} aria-label={`Play “${title}” from ${show}`}>
        <a href={audio} rel="noopener noreferrer">Download the episode</a>
      </audio>
    )
  }
  {
    transcript && (
      <p class="meta">
        <a href={transcript} rel="noopener noreferrer">Read the transcript</a>
      </p>
    )
  }
</article>
