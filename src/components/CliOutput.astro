---
// One command's output on the homepage. Hidden until its command runs: typing it
// (public/cli.js), or clicking its #link when scripts are off, makes this section the
// page's :target, and CSS shows it. The past command's prompt is a short "$"; the full
// nate@nelson:~$ prompt appears only on the live line where you type.
interface Props {
  id: string;
  /** The command, as shown on the prompt line above the output. */
  command: string;
}

const { id, command } = Astro.props;
---

<section id={id} class="cli-out" tabindex="-1" aria-labelledby={`${id}-heading`}>
  <p class="cli-line" aria-hidden="true"><span class="ps1">$</span> {command}</p>
  <slot />
</section>
