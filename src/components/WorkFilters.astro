---
// Static "filters" for the Work page: each option is its own pre-built page,
// so no JavaScript is needed.
import { TOPICS, type Topic } from '../config/topics';
import { getOutlets, getYears, type Clip } from '../lib/content';

interface Props {
  clips: Clip[];
  /** The page currently shown, e.g. "/work/topic/ransomware/". */
  current: string;
}

const { clips, current } = Astro.props;
const usedTopics = (Object.keys(TOPICS) as Topic[]).filter((t) => clips.some((c) => c.data.topics.includes(t)));
const outlets = getOutlets(clips);
const years = getYears(clips);

const groups = [
  { label: 'Topic', items: usedTopics.map((t) => ({ href: `/work/topic/${t}/`, text: TOPICS[t] })) },
  { label: 'Outlet', items: outlets.map((o) => ({ href: `/work/outlet/${o.slug}/`, text: o.name })) },
  { label: 'Year', items: years.map((y) => ({ href: `/work/year/${y}/`, text: String(y) })) },
];
---

<nav class="filters" aria-label="Filter work">
  <dl>
    <div>
      <dt>Show</dt>
      <dd><a href="/work/" aria-current={current === '/work/' ? 'page' : undefined}>All work</a></dd>
    </div>
    {
      groups.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</nav>
