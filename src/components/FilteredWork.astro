---
// Shared body for the static filter pages under /work/.
import BaseLayout from '../layouts/BaseLayout.astro';
import ClipsByYear from './ClipsByYear.astro';
import WorkFilters from './WorkFilters.astro';
import type { Clip } from '../lib/content';

interface Props {
  /** e.g. "Ransomware" */
  name: string;
  /** e.g. "Topic" */
  kind: string;
  allClips: Clip[];
  clips: Clip[];
}

const { name, kind, allClips, clips } = Astro.props;
const count = `${clips.length} ${clips.length === 1 ? 'story' : 'stories'}`;
---

<BaseLayout title={`${name} · Work`} description={`Reporting by Nate Nelson: ${name} (${count}).`}>
  <div class="page-intro">
    <p class="eyebrow">{kind}</p>
    <h1>{name}</h1>
    <p class="meta">{count} · <a href="/work/">All work</a></p>
  </div>
  <WorkFilters clips={allClips} current={Astro.url.pathname} />
  <ClipsByYear clips={clips} />
</BaseLayout>
