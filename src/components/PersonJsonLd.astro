---
// Structured data telling search engines who this site is about (schema.org Person).
// A JSON-LD data block is not executable, so the CSP's script-src 'none' still holds;
// scripts/verify-build.mjs allows <script type="application/ld+json"> and nothing else.
import { PROFILES, SITE } from '../config/site';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  description: SITE.description,
  url: `${SITE.url}/`,
  ...(PROFILES.length > 0 && { sameAs: PROFILES.map((p) => p.url) }),
};

// Escape "<" so the JSON can never close the <script> element early.
const json = JSON.stringify(person).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />
